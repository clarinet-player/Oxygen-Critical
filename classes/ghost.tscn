[gd_scene load_steps=3 format=3 uid="uid://clw8ouiaxohch"]

[sub_resource type="GDScript" id="GDScript_wotty"]
script/source = "extends RigidBody3D



var velocity := Vector3.ZERO
var team := 0
var spawn_time := 0



func _ready():
	velocity += Vector3(randf_range(-2, 2), randf_range(-2, 2), randf_range(-2, 2))
	spawn_time = Time.get_ticks_msec()



func _physics_process(delta):
	
	if Time.get_ticks_msec() - spawn_time > 8000:
		queue_free()
		return
	
	var collision = move_and_collide(velocity * delta)
	if collision:
		velocity = velocity.bounce(collision.get_normal())
		velocity -= collision.get_normal()
"

